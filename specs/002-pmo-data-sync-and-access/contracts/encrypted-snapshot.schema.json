{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sushi-pmo/encrypted-snapshot.schema.json",
  "title": "加密後的工作表快照（頁面 props）",
  "description": "建置時以共用密碼加密 001 快照 v2 的 JSON；瀏覽器以 Web Crypto 解密。見 plan ADR-003。不得包含任何明文案件資料。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kdf", "cipher", "data"],
  "properties": {
    "version": { "const": 1 },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "hash", "iterations", "salt"],
      "properties": {
        "name": { "const": "PBKDF2" },
        "hash": { "const": "SHA-256" },
        "iterations": { "type": "integer", "minimum": 600000 },
        "salt": { "description": "16 位元組，base64", "type": "string", "pattern": "^[A-Za-z0-9+/]{22}==$" }
      }
    },
    "cipher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iv"],
      "properties": {
        "name": { "const": "AES-GCM" },
        "iv": { "description": "12 位元組，base64", "type": "string", "pattern": "^[A-Za-z0-9+/]{16}$" }
      }
    },
    "data": {
      "description": "AES-256-GCM 密文＋16 位元組驗證標籤，base64；明文為 snapshot.schema.json（v2）的 JSON",
      "type": "string",
      "minLength": 24
    }
  }
}
